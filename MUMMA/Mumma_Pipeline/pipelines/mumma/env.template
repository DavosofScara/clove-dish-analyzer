# Mumma Email Configuration Template
# Copy this file to .env.local in the pipelines/mumma/ directory and fill in your actual credentials
# DO NOT commit .env.local to git

# IMAP settings for receiving Lightspeed reports (email checker)
# For Hover email hosting, use:
# MUMMA_EMAIL_HOST=mail.hover.com
# For Outlook/Office365, use:
# MUMMA_EMAIL_HOST=outlook.office365.com

MUMMA_EMAIL_HOST=mail.hover.com
MUMMA_EMAIL_USER=dave@clove.solutions
MUMMA_EMAIL_PASS=your-email-password-here
# Lightspeed changed sender in 2026; include both addresses (comma-separated)
MUMMA_EMAIL_SENDER=do_not_reply@lsk.lightspeedhq.com,no.reply@lightspeedhq.com
MUMMA_EMAIL_LOOKBACK_HOURS=72
# Scheduled cron lookback (hours); use 168 for Monday runs after a missed week
# MUMMA_PIPELINE_LOOKBACK_HOURS=168

# Optional: Delay pipeline until downloaded CSVs are stable. Default 0=disabled.
# WARNING: The stability check polls file sizes repeatedly, which can trigger Dropbox re-indexing.
# Only enable (e.g. 10) if you have proven sync-delay issues.
# MUMMA_WAIT_STABLE_SECONDS=0

# Link used for the \"Open Mumma Master\" button in the weekly email
# MUMMA_MASTER_LINK=https://www.dropbox.com/...

# Email settings for sending weekly reports
# RECOMMENDED: Use Resend API (handles SPF/DKIM/DMARC automatically)
# Get your API key from: https://resend.com/api-keys
# Make sure clove.solutions is verified in Resend: https://resend.com/domains
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@clove.solutions
# Primary recipient for the weekly report (client)
MUMMA_EMAIL_RECIPIENT=client@example.com
# Optional: CC address (e.g. you)
MUMMA_EMAIL_CC=dave@clove.solutions
# Optional: BCC address (e.g. internal copy)
# MUMMA_EMAIL_BCC=dave@clove.solutions

# Scheduled automation: dry = download/process/report only (no client email); full = send email
MUMMA_SCHEDULED_MODE=dry
# MUMMA_DRY_RUN=1

# Alternative: SMTP options (not recommended - requires SPF/DKIM setup)
# Option 1: Gmail SMTP
# MUMMA_GMAIL_USER=your-email@gmail.com
# MUMMA_GMAIL_APP_PASSWORD=your-gmail-app-password

# Option 2: Hover SMTP (requires SPF/DKIM DNS records)
# MUMMA_EMAIL_SMTP_HOST=mail.hover.com
# MUMMA_EMAIL_SMTP_PORT=587
# MUMMA_EMAIL_SMTP_USE_TLS=True

